#include "user_usb.h"
#include "usb_device.h"
#include "user_debug.h"
#include "user_usart.h"

uint8_t usb_tx_data[USB_MAX_SIZE] = {0};
uint8_t usb_rx_data[USB_MAX_SIZE] = {0};
uint8_t usb_rx_finish = 0;

extern USBD_HandleTypeDef hUsbDeviceFS;
extern enum State next_state;

/**
 * @brief usb 发送数据 每次发送64个字节
 * @param buffer 发送的数组
 * @param len 发送的长度
 */
uint8_t USB_Send_Data(uint8_t *buffer, uint8_t len)
{
	for(uint8_t i = 0; i < len; i++)
	{
		usb_tx_data[i] = buffer[i];
	}
	if(USBD_CUSTOM_HID_SendReport(&hUsbDeviceFS, usb_tx_data, USB_MAX_SIZE) == USBD_OK)
	{
		return 1;
	}
	return 0;
}

uint8_t Parse_USB_Data()
{
	uint8_t data_len = 0;
	if((usb_rx_data[3] != 0)&&(usb_rx_data[3] < USB_MAX_SIZE))
	{
		data_len = usb_rx_data[3] + 5;
	}
	else
	{
		sys_debug_info("Data length error!\r\n");
	}
	// 和校验
	if(Check_Data_Sum(usb_rx_data, data_len) == 0)
	{
		sys_debug_info("Check data sum error!\r\n");
		Show_Data_Hex(usb_rx_data, data_len);
		return 0;
	}
	Show_Data_Hex(usb_rx_data, data_len);
	// 判断帧头
	if((usb_rx_data[0] != 0x5a)||(usb_rx_data[1] != 0xa5))
	{
		sys_debug_info("Frame header error!\r\n");
		return 0;
	}
	// 0x20 握手指令
	if(usb_rx_data[2] == 0x20)
	{
		if(usb_rx_data[4] == 0x00)
		{
			uint8_t reBuf[7] = {0x5A, 0xA5, 0x21, 0x02, 0x00, 0x00, 0x22};
			USB_Send_Data(reBuf, 7);
		}
	}
	// 启动停止
	else if(usb_rx_data[2] == 0x30)
	{
		if(usb_rx_data[4] == 0x01)
		{
			uint8_t reBuf[7] = {0x5A, 0xA5, 0x31, 0x02, 0x01, 0x00, 0x33};
			USB_Send_Data(reBuf, 7);
			next_state = STATE_WORK;
		}
		if(usb_rx_data[4] == 0x02)
		{
			uint8_t reBuf[7] = {0x5A, 0xA5, 0x31, 0x02, 0x02, 0x00, 0x34};
			USB_Send_Data(reBuf, 7);
			next_state = STATE_STOP;
		}
	}
	// 查询指令
	else if(usb_rx_data[2] == 0x50)
	{
		if(usb_rx_data[4] == 0x10)
		{
			// 生成范围 [min, max] 的随机数
			int random = (rand() % 220);
			uint8_t reBuf[29] = {0x00};
			reBuf[0] = 0x5A;
			reBuf[1] = 0xA5;
			reBuf[2] = 0x51;
			reBuf[3] = 0x1C;
			reBuf[4] = usb_rx_data[4];
			reBuf[5] = usb_rx_data[5];
			reBuf[6] = usb_rx_data[6];
			reBuf[7] = usb_rx_data[7];
			printf("random = %d\r\n", random);
			reBuf[8] = random&0xFF;
			reBuf[9] = (random&0xFF00) >> 8;
			random = (rand() % 1000);
			printf("random = %d\r\n", random);
			reBuf[10] = random&0xFF;
			reBuf[11] = (random&0xFF00) >> 8;
			reBuf[reBuf[3] + 4] = Get_Data_Sum(reBuf, reBuf[3] + 5);
			Show_Data_Hex(reBuf, reBuf[3] + 5);
			USB_Send_Data(reBuf, reBuf[3] + 5);
		}

	}
	return 1;
}

uint8_t Check_Data_Sum(uint8_t *buffer, uint8_t len)
{
	int sum = 0;
	for(uint8_t i = 0; i < len - 1; i++)
	{
		sum += buffer[i];
	}
	uint8_t key = sum&0xff;
	if(key == buffer[len - 1])
	{
		return 1;
	}
	else
	{
		return 0;
	}
}

void Show_Data_Hex(uint8_t *buffer, uint8_t len)
{
	printf("USB receive : [ len = %d ] [ ", len);
	for(uint8_t i = 0; i < len; i++)
	{
		printf("0x%x ", buffer[i]);
	}
	printf("]\r\n");
}


uint8_t Get_Data_Sum(uint8_t *buffer, uint8_t len)
{
	int sum = 0;
	for(uint8_t i = 0; i < len - 1; i++)
	{
		sum += buffer[i];
	}
	uint8_t key = sum&0xff;
	return key;
}
