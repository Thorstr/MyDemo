uint8_t USB_Rx_Buffer[64];  // 定义接收缓冲区

static uint8_t USBD_CUSTOM_HID_ReceivePacket(USBD_HandleTypeDef *pdev)
{
    // 获取接收到的数据（自定义接收缓冲区大小，64字节为示例）
    uint8_t *buffer = USBD_CUSTOM_HID_GetDataBuffer(pdev);

    // 复制数据到USB接收缓冲区
    for (int i = 0; i < 64; i++) {
        USB_Rx_Buffer[i] = buffer[i];
    }

    // 这里可以根据接收到的数据执行处理

    return USBD_OK;
}

