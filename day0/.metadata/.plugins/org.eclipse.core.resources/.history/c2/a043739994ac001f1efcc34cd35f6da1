	//定义一个指向USBD_CUSTOM_HID_HandleTypeDef结构体的指针
	USBD_CUSTOM_HID_HandleTypeDef *hhid;
	//得到USB接收数据的储存地址
	hhid = (USBD_CUSTOM_HID_HandleTypeDef *)hUsbDeviceFS.pClassData;

	for (uint8_t i = 0; i < 64; i++)
	{
		if (hhid->Report_buf[i] == 0) break;
		printf("%c", (char)hhid->Report_buf[i]);
		//PC_RX_Fifo->PushChar((char)hhid->Report_buf[i]);  	//存入FIFO中
	}
	memset(hhid->Report_buf, 0, 64);
	USBD_CUSTOM_HID_ReceivePacket(&hUsbDeviceFS);			//必须加这一句，否则单片机只能接收一次
  return (USBD_OK);
  /* USER CODE END 6 */
}

