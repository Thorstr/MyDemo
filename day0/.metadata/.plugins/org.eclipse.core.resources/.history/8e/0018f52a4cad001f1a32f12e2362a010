#include "user_usb.h"
#include "usb_device.h"
#include "user_debug.h"

uint8_t usb_tx_data[USB_MAX_SIZE] = {0};
uint8_t usb_rx_data[USB_MAX_SIZE] = {0};
uint8_t usb_rx_start = 0;
uint8_t usb_rx_finish = 0;
uint8_t usb_rx_count = 0;

extern USBD_HandleTypeDef hUsbDeviceFS;

/**
 * @brief usb 发送数据 每次发送64个字节
 * @param buffer 发送的数组
 * @param len 发送的长度
 */
uint8_t USB_Send_Data(uint8_t *buffer, uint8_t len)
{
	for(uint8_t i = 0; i < len; i++)
	{
		usb_tx_data[i] = buffer[i];
	}
	if(USBD_CUSTOM_HID_SendReport(&hUsbDeviceFS, usb_tx_data, USB_MAX_SIZE) == USBD_OK)
	{
		return 1;
	}
	return 0;
}

uint8_t Parse_USB_Data()
{
	uint8_t data_len = 0;
	if(buffer[3] != 0)
	{
		data_len = buffer[3] + 4;
	}
	else
	{
		sys_debug_info("Data length error!\r\n");
	}
	// 和校验
	if(Check_Data_Sum == 0)
	{
		sys_debug_info("Check data sum error!\r\n");
		return 0;
	}
	// 判断帧头
	if((buffer[0] != 0x5a)||(buffer[1] != 0xa5))
	{
		sys_debug_info("Frame header error!\r\n");
		return 0;
	}
	// 0x20 握手指令
	if(buffer[2] == 0x20)
	{
		if(buffer[4] = 0x00)
		{
			uint8_t reBuf[7] = {0x5A, 0xA5, 0x21, 0x02, 0x00, 0x00, 0x22};
			USB_Send_Data(reBuf, 7);
		}
	}
}

uint8_t Check_Data_Sum(uint8_t *buffer, uint8_t len)
{
	int sum = 0;
	for(uint8_t i = 0; i < len - 1; i++)
	{
		sum += buffer[i];
	}
	uint8_t key = sum&0xff;
	if(key == buffer[len - 1])
	{
		return 1;
	}
	else
	{
		return 0;
	}
}
